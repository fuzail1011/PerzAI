# Database
DATABASE_URL={postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>}

# JWT
JWT_SECRET={your_jwt_secret}
JWT_ALGORITHM={jwt_algorithm}
ACCESS_TOKEN_EXPIRE_MINUTES={expire_time}

# App
APP_HOST={host}
APP_PORT={port}

# Azure OpenAI
AZURE_OPENAI_API_KEY={your_azure_openai_key}
AZURE_OPENAI_ENDPOINT={your_azure_openai_endpoint}
AZURE_OPENAI_API_VERSION={your_azure_openai_api_version}
AZURE_OPENAI_EMBEDDING_MODEL={your_azure_openai_embedding_model}

OPENROUTER_API_KEY={your_openrouter_api_key}
OPENROUTER_ENDPOINT={your_openrouter_endpoint}
OPENROUTER_LLM_MODEL={your_openrouter_model}